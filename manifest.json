{
  "manifest_version": 3,
  "name": "YouTube Popout",
  "version": "1.1.1",
  "description": "A floating picture-in-picture player, one click beside YouTube's Settings button.",
  "minimum_chrome_version": "88",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
